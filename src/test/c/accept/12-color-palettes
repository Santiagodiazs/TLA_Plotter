scene Parque {
  palette {
    trunk: #6B4F2A;
    crown: #2E8B57;
    grass: rgb(76,175,80);
  }

  draw rectangle ground { at (0, 350); size 900x50; fill grass; }
  draw rectangle trunk1 { at (120, 350); size 20x40; fill trunk; }
  draw circle crown1 { at (130, 330); radius 25; fill crown; }
  draw rectangle trunk2 { at (180, 360); size 20x40; fill trunk; }
  draw circle crown2 { at (190, 340); radius 25; fill crown; }
}