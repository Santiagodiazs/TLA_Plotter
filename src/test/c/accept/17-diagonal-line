scene DiagonalLine {
    draw line diagonal {
        at (50, 50);
        from (0, 0);
        to (200, 200);
        stroke #FF0000;
        stroke_width 5;
    }
    
    draw line diagonal2 {
        at (300, 100);
        from (0, 0);
        to (150, 300);
        stroke #0000FF;
        stroke_width 3;
    }
}
