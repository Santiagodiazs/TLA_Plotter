scene ZOverlap {
    layer base_layer z 0 {
        draw rectangle base {
            at (100, 100);
            size 200x150;
            fill #FF0000;
        }
    }
    
    layer middle_layer z 1 {
        draw rectangle overlapping {
            at (150, 120);
            size 100x80;
            fill #00FF00;
        }
    }
    
    layer top_layer z 2 {
        draw circle on_top {
            at (200, 150);
            radius 30;
            fill #0000FF;
        }
    }
}
