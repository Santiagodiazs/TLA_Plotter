scene StrokeTest {
    draw rectangle rect1 {
        at (50, 50);
        size 100x80;
        fill #FF0000;
        stroke #000000;
        stroke_width 1;
        opacity 0.8;
    }
    
    draw rectangle rect2 {
        at (200, 50);
        size 100x80;
        fill #00FF00;
        stroke #000000;
        stroke_width 5;
        opacity 0.6;
    }
    
    draw rectangle rect3 {
        at (350, 50);
        size 100x80;
        fill #0000FF;
        stroke #000000;
        stroke_width 10;
        opacity 0.4;
    }
}
