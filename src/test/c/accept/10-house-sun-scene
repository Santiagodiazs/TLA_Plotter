scene MyHouse {
    draw rectangle house {
        at (100, 100);
        size 200x150;
        fill #8B4513;
        stroke #654321;
        stroke_width 2px;
    }
    
    draw circle sun {
        at (400, 80);
        radius 50;
        fill #FFD700;
        stroke #FFA500;
        stroke_width 3px;
    }
}
